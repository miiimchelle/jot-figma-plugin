{
  "name": "Jot",
  "version": "2.1.0",
  "description": "A lightweight design decision journal for Figma",
  "main": "code.js",
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "esbuild code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017",
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "node scripts/build-ui.mjs --watch & esbuild code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017 --watch",
    "watch": "node scripts/build-ui.mjs --watch & esbuild code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017 --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist --fix .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.121.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/preact": "^3.2.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "eslint": "^8.54.0",
    "jsdom": "^28.0.0",
    "serve": "^14.2.5",
    "typescript": "^5.3.2",
    "vitest": "^4.0.18"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": [
        "./tsconfig.json",
        "./tsconfig.ui.json"
      ]
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "preact": "^10.29.8"
  }
}
